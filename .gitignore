# --- caches, byte-code, transient ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
test-results/
uploads/

# --- datasets: large, and redistributed under their own licence, so fetch them rather than vendor them ---
data/

