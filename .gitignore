_old/

# --- fold artefacts: keep only the out-of-fold logits the dashboard and the tests actually read ---
rerun_results/*
!rerun_results/mlp_fold*.pt
!rerun_results/summary.json

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
